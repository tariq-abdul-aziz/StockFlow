                      onChange={(e) =>
                        handleItemChange(item.id, "rate", e.target.value)
                      }
                      placeholder="0"
                      className="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm outline-none focus:border-gray-400"
