<file path="src/services/firestoreService.js">
import {
    collection,
    doc,
    getDocs,
    getDoc,
    setDoc,
    updateDoc,
    query,
    orderBy,
    serverTimestamp,
} from "firebase/firestore"
import {db} from "../firebase"
import { products as defaultProducts } from "../components/data/products"

// Helper to get user-specific subcollection reference
const getUserColRef = (userId, collectionName) => {
  return collection(db, "users", userId, collectionName);
};

// PRODUCTS
export const getProducts = async (userId) => {
    const colRef = getUserColRef(userId, "products");
    const snapshot = await getDocs(colRef);

    // If new user with no products, seed with default catalog
    if (snapshot.empty) {
    const seeded = [];
    for (const prod of defaultProducts) {
      const docRef = doc(colRef, String(prod.id));
      await setDoc(docRef, { ...prod, createdAt: serverTimestamp() });
      seeded.push({ ...prod, id: prod.id });
    }
    return seeded;
  }

  return snapshot.docs.map((docSnap) => ({
    ...docSnap.data(),
    id: isNaN(docSnap.id) ? docSnap.id : Number(docSnap.id),
  }));
};

export const saveProduct = async (userId, productData) => {
  const colRef = getUserColRef(userId, "products");
  const docId = productData.id ? String(productData.id) : String(Date.now());
  const docRef = doc(colRef, docId);

  const payload = {
    ...productData,
    id: isNaN(docId) ? docId : Number(docId),
    updatedAt: serverTimestamp(),
  };
  await setDoc(docRef, payload, { merge: true });
  return payload;
};

export const updateProductStock = async (userId, productId, newStock, historyEntry) => {
  const docRef = doc(db, "users", userId, "products", String(productId));
  const snap = await getDoc(docRef);

  if (!snap.exists()) return;
  const currentData = snap.data();
  const existingHistory = currentData.stockHistory || [];

  await updateDoc(docRef, {
    currentStock: Number(newStock),
    stockHistory: [historyEntry, ...existingHistory],
    updatedAt: serverTimestamp(),
  });
};

// CUSTOMERS
export const getCustomers = async (userId) => {
  const colRef = getUserColRef(userId, "customers");
  const snapshot = await getDocs(colRef);
  return snapshot.docs.map((docSnap) => ({
    ...docSnap.data(),
    id: isNaN(docSnap.id) ? docSnap.id : Number(docSnap.id),
  }));
};

export const saveCustomer = async (userId, customerData) => {
  const colRef = getUserColRef(userId, "customers");
  const docId = customerData.id ? String(customerData.id) : String(Date.now());
  const docRef = doc(colRef, docId);

  const payload = {
    ...customerData,
    id: isNaN(docId) ? docId : Number(docId),
    updatedAt: serverTimestamp(),
  };

  await setDoc(docRef, payload, { merge: true });
  return payload;
};

// INVOICES
export const getInvoices = async (userId) => {
  const colRef = getUserColRef(userId, "invoices");
  const q = query(colRef, orderBy("createdAt", "desc"));
  try {
    const snapshot = await getDocs(q);
    return snapshot.docs.map((docSnap) => ({
      ...docSnap.data(),
      id: docSnap.id,
    }));
  } catch {
    const snapshot = await getDocs(colRef);
    return snapshot.docs.map((docSnap) => ({
      ...docSnap.data(),
      id: docSnap.id,
    }));
  }
};

export const saveInvoice = async (userId, invoiceData) => {
  const docId = String(invoiceData.invoiceNumber || Date.now());
  const docRef = doc(db, "users", userId, "invoices", docId);

  const payload = {
    ...invoiceData,
    id: docId,
    createdAt: serverTimestamp(),
  };

  await setDoc(docRef, payload);
  return payload;
};
