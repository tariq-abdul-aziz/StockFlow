<file path="src/components/invoices/InvoiceItems.jsx">
import React, { useState } from "react";
import { getGstByHsn } from "../data/hsnCodes";
import { Plus, Trash2 } from "lucide-react";
import { products as defaultProducts } from "../data/products";

const InvoiceItems = ({ items, setItems }) => {
  // Load current inventory products from LocalStorage
  const [inventory] = useState(() => {
    const saved = localStorage.getItem("products");
    return saved ? JSON.parse(saved) : defaultProducts;
  });

  const handleProductSelect = (id, selectedProductId) => {
    const selected = inventory.find((p) => p.id === Number(selectedProductId));
    const fallbackCatalogProduct = defaultProducts.find((p) => p.id === Number (selectedProductId));
    const resolveHsn = selected?.hsn || fallbackCatalogProduct?.hsn || "";

    setItems((prevItems) =>
      prevItems.map((item) =>
        item.id === id
          ? {
              ...item,
              productId: selected ? selected.id : "",
              product: selected ? selected.productName : "",
              hsn: resolveHsn,
              rate: selected ? selected.sellingPrice : "",
              gst:
                selected?.gst ??
                (selected?.hsn ? (getGstByHsn(selected.hsn) ?? 18) : 18),
              availableStock: selected
                ? Number(selected.currentStock ?? 0)
                : null,
              serialTracking: Boolean(selected?.serialTracking),
              availableSerials: selected?.serialNumbers || [],
              selectedSerials: [],
            }
          : item,
      ),
    );
  };

  const handleItemChange = (id, field, value) => {
    setItems((prevItems) =>
      prevItems.map((item) => {
        if (item.id !== id) return item;

        const updatedItem = { ...item, [field]: value };

        // When HSN is changed, auto-assign GST percentage if code matches directory
        if (field === "hsn") {
          const autoGst = getGstByHsn(value);
          if (autoGst !== null) {
            updatedItem.gst = autoGst;
          }
        }

        return updatedItem;
      }),
    );
  };

  const addItem = () => {
    setItems((prevItems) => [
      ...prevItems,
      {
        id: Date.now(),
        productId: "",
        product: "",
        quantity: 1,
        rate: "",
        gst: 18,
        serialTracking: false,
        availableSerials: [],
        selectedSerials: [],
      },
    ]);
  };

  const handleToggleSerial = (itemId, serial) => {
    setItems((prevItems) =>
      prevItems.map((item) => {
        if (item.id !== itemId) return item;
        const current = item.selectedSerials || [];
        const exists = current.includes(serial);
        const updated = exists
          ? current.filter((s) => s !== serial)
          : [...current, serial];
        return {
          ...item,
          selectedSerials: updated,
        };
      }),
    );
  };

  const removeItem = (id) => {
    setItems((prevItems) => prevItems.filter((item) => item.id !== id));
  };

  return (
    <section className="mt-5 bg-white border border-gray-200 rounded-xl p-4 sm:p-6">
      <div className="flex items-center justify-between mb-5">
        <div>
          <h2 className="text-base font-semibold text-gray-900">
            Invoice Items
          </h2>
          <p className="text-sm text-gray-500 mt-1">
            Add products or services to this invoice.
          </p>
        </div>

        <button
          type="button"
          onClick={addItem}
          className="flex items-center gap-2 px-3 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800"
        >
          <Plus size={16} />
          Add Item
        </button>
      </div>

      <div className="space-y-3">
        {items.map((item) => {
          const lineTotal =
            (Number(item.quantity) || 0) * (Number(item.rate) || 0);

          return (
            <div
              key={item.id}
              className="grid grid-cols-1 sm:grid-cols-4 gap-3 items-end"
            >
              {/* Product Dropdown & HSN Input */}
              <div className="sm:col-span-3">
                <label className="block text-xs font-medium text-gray-600 mb-1">
                  Product
                </label>

                <select
                  value={item.productId || ""}
                  onChange={(e) => handleProductSelect(item.id, e.target.value)}
                  className="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-gray-400"
                >
                  <option>Select a product</option>
                  {inventory.map((prod) => (
                    <option
                      key={prod.id}
                      value={prod.id}
                      disabled={Number(prod.currentStock ?? 0) === 0}
                    >
                      {prod.productName} {prod.sku} - {prod.currentStock} in
                      stock
                      {Number(prod.currentStock ?? 0) === 0
                        ? " (Out of Stock)"
                        : ""}
                    </option>
                  ))}
                </select>
              </div>

              {/* HSN Code Input */}
              <div className="sm:col-span-1">
                <label className="block text-xs font-medium text-gray-600 mb-1">
                  HSN / SAC
                </label>
                <input type="text" 
                placeholder="e.g. 8671"
                value={item.hsn || ""}
                onChange={(e) => handleItemChange(item.id, "hsn", e.target.value)}
                className="w-full border border-gray-200 rounded-lg p-2 text-sm font-mono outline-none focus:border-gray-400"
                />
              </div>

              {/* Quantity */}
              <div className="sm:col-span-2">
                <div className="flex items-center justify-between mb-1">
                  <label className="block text-xs font-medium text-gray-600">
                    Quantity
                  </label>
                  {item.productId && (
                    <span
                      className={`text-[11px] font-semibold italic ${
                        item.availableStock === 0
                          ? "text-red-600"
                          : item.availableStock <= 5
                            ? "text-amber-600"
                            : "text-emerald-600"
                      }`}
                    >
                      {item.availableStock} avail
                    </span>
                  )}
                </div>

                <input
                  type="number"
                  min="1"
                  max={
                    item.availableStock !== null &&
                    item.availableStock !== undefined
                      ? item.availableStock
                      : ""
                  }
                  value={item.quantity}
                  onChange={(e) => {
                    const val = Number(e.target.value);
                    if (
                      item.availableStock !== null &&
                      item.availableStock !== undefined &&
                      val > item.availableStock
                    ) {
                      handleItemChange(
                        item.id,
                        "quantity",
                        item.availableStock,
                      );
                    } else {
                      handleItemChange(item.id, "quantity", e.target.value);
                    }
                  }}
                  className={`w-full border rounded-lg px-3 py-2.5 text-sm outline-none ${item.availableStock !== null && Number(item.quantity) > item.availableStock ? "border-red-500 focus:border-red-500" : "border-gray-200 focus:border-gray-400"}`}
                />
                {item.availableStock !== null &&
                  Number(item.quantity) > item.availableStock && (
                    <p className="text-[10px] text-red-600 mt-0.5">
                      Exceeds stock ({item.availableStock})
                    </p>
                  )}
              </div>

              {/* Rate */}
              <div className="sm:col-span-2">
                <label className="block text-xs font-medium text-gray-600 mb-1">
                  Rate
                </label>

                <input
                  type="number"
                  min="0"
                  placeholder="0.00"
                  value={item.rate}
                  onChange={(e) =>
                    handleItemChange(item.id, "rate", e.target.value)
                  }
                  className="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm"
                />
              </div>

              {/* GST % */}
              <div className="sm:col-span-1">
                <label className="block text-xs font-medium text-gray-600 mb-1">
                  GST %
                </label>
                <input
                  type="number"
                  min="0"
                  max="100"
                  value={item.gst ?? 18}
                  onChange={(e) =>
                    handleItemChange(item.id, "gst", e.target.value)
                  }
                  className="w-full border border-gray-200 rounded-lg px-2 py-2.5 text-sm text-center outline-none focus:border-gray-400"
                />
              </div>

              {/* Line Total */}
              <div className="sm:col-span-2">
                <label className="block text-xs font-medium text-gray-600 mb-1">
                  Total
                </label>
                <div className="w-full border border-gray-100 bg-gray-50 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-900 text-right">
                  ₹
                  {lineTotal.toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                  })}
                </div>
              </div>

              {/* Remove */}
              <div className="sm:col-span-1">
                <button
                  type="button"
                  onClick={() => removeItem(item.id)}
                  disabled={item.length === 1}
                  title="Remove item"
                  className="w-full flex items-center justify-center gap-1 px-3 py-2.5 border border-gray-200 rounded-lg text-sm text-red-600 hover:bg-red-50 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                >
                  <Trash2 size={16} />
                  Remove
                </button>
              </div>

              {/* Serial Numbers Selection (if serial tracking is enabled) */}
              {item.serialTracking && (
                <div className="col-span-full bg-gray-50border border-gray-200 rounded-lg p-3 mt-1">
                  <div className="flex items-center justify-between mb-2">
                    <span className="text-xs font-semibold text-gray-700">
                      Select Serial Numbers:
                    </span>
                    <span
                      className={`text-xs font-medium ${
                        (item.selectedSerials?.length || 0) ===
                        Number(item.quantity)
                          ? "text-emerald-600"
                          : "text-amber-600"
                      }`}
                    >
                      Selected: {item.selectedSerials?.length || 0} /{" "}
                      {item.quantity || 0}
                    </span>
                  </div>

                  {(item.availableSerials || []).length == 0 ? (
                    <p className="text-xs text-red-600">
                      No serial numbers found in stock for this product.
                    </p>
                  ) : (
                    <div className="flex flex-wrap gap-2 max-h-32 overflow-y-auto pt-1">
                      {item.availableSerials.map((serial) => {
                        const isChecked =
                          item.selectedSerials?.includes(serial);
                        return (
                          <label
                            key={serial}
                            className={`flex items-center gap-1.5 px-1.5 py-1 rounded border text-xs cursor-pointer select-none transition-colors ${
                              isChecked
                                ? "bg-gray-900 border-gray-900 text-white"
                                : "bg-white border-gray-200 text-gray-700 hover:border-gray-400"
                            }`}
                          >
                            <input
                              type="checkbox"
                              className="hidden"
                              checked={isChecked}
                              disabled={
                                !isChecked &&
                                (item.selectedSerials?.length || 0) >=
                                  Number(item.quantity)
                              }
                              onChange={() =>
                                handleToggleSerial(item.id, serial)
                              }
                            />
                            <span>{serial}</span>
                          </label>
                        );
                      })}
                    </div>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  );
};

export default InvoiceItems;
</file>

